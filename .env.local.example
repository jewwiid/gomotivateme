# =================================================================
# gomotivateme environment variables
# =================================================================
# Copy this file to `.env.local` and fill in the real values.
# Convex will write the dev values automatically when you run
# `npx convex dev` for the first time. Production values are set
# in the Vercel project settings.
# =================================================================

# --- Convex (dev) ---
# Set by `npx convex dev`. Keep this in `.env.local`, NOT in Vercel.
CONVEX_DEPLOY_KEY=

# --- Convex (public) ---
# Same value as the dev deployment URL while developing.
# In production, swap this for the URL from `npx convex deploy`.
NEXT_PUBLIC_CONVEX_URL=

# --- Convex (server-side, edge runtime) ---
# Same value as NEXT_PUBLIC_CONVEX_URL. Used by the dynamic OG
# image route which runs on the edge.
CONVEX_URL=

# --- App ---
# The canonical URL of the deployed site. Used in absolute
# share links shown in the dashboard and in OG image metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Partner connect (AI Boss Leader). Set on the Convex deployment:
#   npx convex env set AIBL_REDIRECT_ORIGINS "https://www.iamaibl.com,http://localhost:5173"
#   npx convex env set SITE_URL "https://www.gomotivate.me"

# --- Email (Resend) ---
# The queue + templates are wired. Until these are set, the drain cron
# no-ops and emails stay "pending" in the notifications table — they'll
# send automatically once the key is added.
#
# Set on the Convex deployment (NOT Vercel — the action runs on Convex):
#   npx convex env set RESEND_API_KEY "re_xxxxx"
#   npx convex env set RESEND_FROM_ADDRESS "GoMotivateMe <hello@gomotivateme.com>"
RESEND_API_KEY=
RESEND_FROM_ADDRESS=GoMotivateMe <hello@gomotivateme.com>

# --- AI assistance + content moderation (OpenAI) ---
# Set on the Convex deployment. The key powers optional goal/support drafting
# and automated moderation; it is never exposed to the browser.
# AI_DAILY_BUDGET_USD defaults to 5 when omitted. AI_DISABLED=1 is the
# emergency kill switch for generated assistance (moderation remains active).
#   npx convex env set OPENAI_API_KEY "sk-..."
#   npx convex env set AI_DAILY_BUDGET_USD "5"
OPENAI_API_KEY=
AI_DAILY_BUDGET_USD=5
AI_DISABLED=0
# GitHub App. Create one as described in docs/github-goal-sync.md. Set these
# in the Convex deployment, never in the browser or Vercel's public variables.
# GITHUB_APP_PRIVATE_KEY is the PKCS#8 PEM derived from the one-time GitHub
# download; escaped newlines are accepted. GITHUB_APP_WEBHOOK_SECRET must
# match GitHub exactly.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# GitHub App user authorization securely matches an existing installation to
# the signed-in GoMotivateMe profile. The client ID is public; the secret is not.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_AUTHORIZATION_CALLBACK_URL=https://compassionate-crab-352.eu-west-1.convex.site/github/app/authorize
# Optional; defaults to gpt-5.6-luna when OPENAI_API_KEY is already configured.
GITHUB_SUMMARY_MODEL=
